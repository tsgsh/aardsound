pcm.{{ dmixer_plugin }} {
    type plug
    slave.pcm "{{ dmixer_dmix_device }}"
}

pcm.{{ dmixer_dmix_device }} {
    type dmix
    ipc_key {{ dmixer_ipc_key }}
    ipc_key_add_uid false
    ipc_perm 0666
    slave {
        pcm "{{ dmixer_output_device }}"
        rate {{ dmixer_rate }}
        format {{ dmixer_format }}
        channels {{ dmixer_channels}}
        period_time {{ dmixer_period_time }}
        period_size {{ dmixer_period_size }}
        periods {{ dmixer_periods }}
        buffer_size {{ dmixer_buffer_size }}
    }
    bindings {
{% for n in range(dmixer_channels) %}
        {{ n }} {{ n }}
{% endfor %}
    }
}

ctl.{{ dmixer_dmix_device }} {
    type hw
    card {{ dmixer_card }}
}
