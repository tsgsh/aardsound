pcm.{{ bluetooth_bluealsa_pcm }} {
    type bluealsa
    service "org.bluealsa"
    device "{{ bluetooth_adapter_mac }}"
    interface "hci{{ bluetooth_adapter_index }}"
    profile "a2dp"
    volume "{{ bluetooth_initial_volume }}"
    codec "{{ bluetooth_codec }}"
    hint {
        description {{ bluetooth_name | quote }}
    }
}

ctl.{{ bluetooth_bluealsa_pcm }} {
    type bluealsa
    service "org.bluealsa"
}
