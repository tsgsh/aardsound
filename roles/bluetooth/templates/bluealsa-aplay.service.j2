[Unit]
Description={{ bluetooth_aplay_description }}
Documentation=man:bluealsa(8)
Requisite=dbus.service
After=bluetooth.service bluealsa.service
Requires=bluetooth.service bluealsa.service

[Service]
Type=simple
User={{ bluetooth_aplay_service }}
Group=audio
ExecStart=/usr/bin/bluealsa-aplay {{ bluetooth_bluealsa_aplay_args }}
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-iser.target
